<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.javastudio</groupId>
    <artifactId>JavaStudio</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>JavaStudio</name>
    <description>Plugin dùng tạo plugin và chạy lệnh bằng ngôn ngữ Java (Paper, Purpur, Spigot 1.20.5 - 26.3+)</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.version>1.20.6-R0.1-SNAPSHOT</paper.version>
    </properties>

    <repositories>
        <!-- PaperMC Repository (Hỗ trợ Paper, Purpur) -->
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- SpigotMC Repository -->
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <!-- Maven Central -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <!-- Sonatype Repository -->
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (Bao hàm Spigot/Bukkit API) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/paper-api.jar</systemPath>
        </dependency>

        <!-- Kyori Adventure & Examination APIs -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.17.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/adventure-api-4.17.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-key</artifactId>
            <version>4.17.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/adventure-key-4.17.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori.examination</groupId>
            <artifactId>examination-api</artifactId>
            <version>1.3.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/examination-api-1.3.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori.examination</groupId>
            <artifactId>examination-string</artifactId>
            <version>1.3.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/examination-string-1.3.0.jar</systemPath>
        </dependency>

        <!-- BungeeCord Chat API -->
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-chat</artifactId>
            <version>1.20-R0.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/bungeecord-chat-1.20-R0.2.jar</systemPath>
        </dependency>

        <!-- JetBrains Annotations -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/annotations-24.1.0.jar</systemPath>
        </dependency>

        <!-- Google Guava & Error Prone Annotations -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.0.0-jre</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/guava-33.0.0-jre.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.google.errorprone</groupId>
            <artifactId>error_prone_annotations</artifactId>
            <version>2.27.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/error_prone_annotations-2.27.0.jar</systemPath>
        </dependency>

        <!-- PlaceholderAPI (PAPI Hook) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/placeholderapi-2.11.6.jar</systemPath>
        </dependency>

        <!-- Mojang Brigadier -->
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>brigadier</artifactId>
            <version>1.0.18</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/brigadier-1.0.18.jar</systemPath>
        </dependency>

        <!-- Netty Transport & Common -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
            <version>4.1.100.Final</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/netty-transport-4.1.100.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-common</artifactId>
            <version>4.1.100.Final</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/.libs/netty-common-4.1.100.Final.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- Maven Compiler Plugin hỗ trợ Java 21+ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Maven Jar Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
